<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Portfolio</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
</head>

<body>
    <header class="site-header">
        <a class="site-name" asp-page="/Index">Portfolio</a>
        <nav>
            <a asp-page="/Projects/Index">Projects</a>
            @* <a asp-page="/About">About</a> *@
            <a asp-page="/Contacts">Contacts</a>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <p>
            Written by hand in C# and Razor Pages while learning .NET.
            Last updated @DateTime.Today.ToString("MMMM yyyy").
        </p>
        <p>
            All rights reserved with &#xA9; Uttam Chamling Rai.
        </p>
    </footer>
</body>

</html>