<h1>Contact</h1>

@if (Model.SentMessage != null)
{
    <p class="notice">@Model.SentMessage</p>
}

<p>The quickest way to reach me. I read every message.</p>

<form method="post">
    <label asp-for="Input.Name">Your Name</label>
    <input asp-for="Input.Name" />
    <span asp-validation-for="Input.Name" class="field-error"></span>

    <label asp-for="Input.Email">Your email</label>
    <input asp-for="Input.Email" />
    <span asp-validation-for="Input.Email" class="field-error"></span>

    <label asp-for="Input.Subject">Subject</label>
    <input asp-for="Input.Subject" />
    <span asp-validation-for="Input.Subject" class="field-error"></span>

    <label asp-for="Input.Message">Message</label>
    <textarea asp-for="Input.Message"></textarea>
    <span asp-validation-for="Input.Message" class="field-error"></span>

    <input asp-for="Input.Website" style="display:none" autocomplete="off" tabindex="-1" />
    
    <button type="submit">Send</button>
</form>