@page
@model IndexModel
@{
    ViewData["Title"] = "Projects";
}
<header class="projects-intro">
    <p class="muted">A few things I’ve worked on</p>
    <h1>Projects</h1>
    <p>Projects that have helped me learn and build practical experience.</p>
</header>

<section class="project-grid" aria-label="Selected projects">
    <article class="project-card">
        <p class="project-type">01 · Mobile app</p>
        <h2>ToDo app</h2>
        <p>
            A simple task-management app built with Flutter.
            It helped me practise building a useful mobile interface.
        </p>
        <ul class="project-tags" aria-label="Technologies">
            <li>Flutter</li>
        </ul>
    </article>

    <article class="project-card">
        <p class="project-type">02 · Web app</p>
        <h2>PDF Generator</h2>
        <p>
            A web app for creating PDFs from forms filled in by the user,
            including forms for government documents.
        </p>
        @* Add technology labels here only when you can confirm the tools used. *@
    </article>

    <article class="project-card">
        <p class="project-type">03 · Integration</p>
        <h2>MAW OTCI Integration</h2>
        <p>
            I worked on integrating Business Central and Dynamics NAV with
            a third-party app, so users could create opportunities that
            eventually became sales orders.
        </p>
        <ul class="project-tags" aria-label="Technologies">
            <li>Business Central</li>
            <li>Dynamics NAV</li>
            <li>Integration</li>
        </ul>
    </article>
</section>